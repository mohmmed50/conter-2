SCU_USERNAME=your_username_here
SCU_PASSWORD=your_password_here

# Optional: only needed for the shared "flagged for deletion" list to persist
# reliably on Vercel. Create a free database at https://console.upstash.com/
# (Redis -> Create Database), then copy its REST URL and REST Token here.
# Without these, flagged activities are kept in memory only (fine for local
# testing, not durable on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
